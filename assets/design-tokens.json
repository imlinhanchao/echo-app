    "card": "16px",
    "control": "12px",
    "pill": "999px",
    "sheet": "24px"
  },
  "elevation": {
    "dark": "以暖墨黑层级色与 0.6-0.8px 极细描边区分，避免高饱和阴影与强光晕",
